# Local credentials and secrets (never commit these)
*-credenciais
*-credentials
*.credentials
*._credentials
.env
.env.*

# Python
__pycache__/
**/__pycache__/
*.pyc
backend/.venv/
.venv/
*.egg-info/

# Database
*.db
*.sqlite
*.sqlite3

# Logs
logs/*.log

# ROMs / BIOS / cores (large binary game assets, never versioned)
emulator/roms/*
!emulator/roms/ps1
!emulator/roms/snes
emulator/roms/ps1/*
!emulator/roms/ps1/.gitkeep
emulator/roms/snes/*
!emulator/roms/snes/.gitkeep
emulator/bios/*
!emulator/bios/.gitkeep
emulator/cores/*
!emulator/cores/.gitkeep
emulator/saves/*
!emulator/saves/.gitkeep
emulator/states/*
!emulator/states/.gitkeep

# Third-party binaries downloaded by scripts (not versioned, see scripts/install_mediamtx.sh)
bin/

# Source cloned to build the PS1 core (see scripts/setup.sh)
emulator/pcsx_rearmed_src/

# Self-signed certificate generated automatically by mediamtx (optional MOQ server)
auto.crt
auto.key

# Runtime state written by the API — not source code
config/storage.json
# User-specific core paths (copy cores.json.example → cores.json and edit)
config/cores.json

# OS / editor
.DS_Store
Thumbs.db

# Compiled SDL preload binary (generated by the Dockerfile)
container/*.so
.claude/
instucoes.md
.pytest_tmp/

# Personal notes (local only)
instucoes.md

# PS2 POC (branch poc/ps2-support-headless-gl) - BIOS/ISO are never versioned
ps2-poc-bios/
ps2-poc-empty.iso
*.bin
*.iso
*.chd
*.NVM
*.MEC
*.EROM
*.ROM1
*.ROM2
